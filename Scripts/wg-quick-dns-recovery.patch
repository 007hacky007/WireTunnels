+		cmd "$WIRETUNNELS_DNS_HELPER" --dns-release "$WIRETUNNELS_DNS_TOKEN"
+		return $?
+	fi
 	local service response i
 	[[ $DNS_STATE_SAVED -eq 1 ]] || load_dns_state || return 0
